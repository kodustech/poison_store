<div class="container mt-4" style="max-width: 500px;">
  <h1>Editar Operador</h1>

  <%= form_with model: @operator, url: operator_path(@operator), method: :patch, local: true, scope: :operator do |form| %>
    <div class="mb-3">
      <%= form.label :name, 'Nome', class: 'form-label' %>
      <%= form.text_field :name, value: @operator.name, class: 'form-control' %>
    </div>

    <div class="mb-3">
      <%= form.label :email, 'Email', class: 'form-label' %>
      <%= form.email_field :email, value: @operator.email, class: 'form-control' %>
    </div>

    <div class="mb-3">
      <%= form.label :role, 'Papel', class: 'form-label' %>
      <%= form.select :role, Operator::ROLES.map { |r| [r, r] }, { selected: @operator.role }, class: 'form-select' %>
    </div>

    <div class="mb-3 form-check">
      <%= form.check_box :active, { checked: @operator.active }, true, false %>
      <%= form.label :active, 'Ativo', class: 'form-check-label' %>
    </div>

    <%= form.submit 'Salvar', class: 'btn btn-primary' %>
    <%= link_to 'Voltar', operator_path(@operator), class: 'btn btn-outline-secondary' %>
  <% end %>
</div>
